/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Sundry verwendet Automatisierung, um Dateien im Finder zu bewegen, Objekte in den Papierkorb zu legen und Terminal-Befehle zu öffnen, wenn du Homebrew-Aktionen anforderst.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Sundry nutzt den Ton jeder App, um ihre Lautstärke im Mixer zu regeln und den Ton des Mac in die Bildschirmaufnahmen aufzunehmen, die du startest. Nichts verlässt deinen Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Sundry verwendet Bluetooth nur, um den Akkustand verbundener Peripheriegeräte zu lesen. Nichts verlässt deinen Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Sundry nimmt dein Mikrofon nur auf, wenn du es für eine Bildschirmaufnahme einschaltest. Der Ton bleibt auf deinem Mac, außer du erstellst einen temporären Link.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Sundry zeigt deine Kamera nur im Vorschaufenster, das du öffnest, damit du vor einem Anruf prüfen kannst, wie du aussiehst. Es wird nichts aufgezeichnet und nichts verlässt deinen Mac.";

/* macOS Downloads folder permission prompt. */
